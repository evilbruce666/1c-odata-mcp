{
  "name": "1c-odata-mcp",
  "version": "0.12.0",
  "description": "MCP server for 1C:Enterprise (1С) over OData. Ask your accounting database in natural language — debtors and creditors by due date, unpaid invoices, cash on hand, month-close checks, account cards, reconciliation statements, sales, taxes, cash flow, account turnover, postings — from any MCP client (Claude, Cursor, VS Code, local models…). 75 tools, run with npx, nothing installed inside 1C; read-only by default with opt-in (gated) write.",
  "type": "module",
  "bin": {
    "1c-odata-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "apps",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evilbruce666/1c-odata-mcp.git"
  },
  "homepage": "https://github.com/evilbruce666/1c-odata-mcp#readme",
  "bugs": {
    "url": "https://github.com/evilbruce666/1c-odata-mcp/issues"
  },
  "author": "evilbruce666",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "probe": "node dist/scripts/probe-metadata.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build && node --eval \"require('fs').rmSync('dist/scripts',{recursive:true,force:true})\"",
    "manifest": "npm run build && node dist/scripts/gen-manifest.js",
    "test:live": "npm run build && node --env-file=.env dist/scripts/live-write.js",
    "test:live:read": "npm run build && node --env-file=.env dist/scripts/live-read.js",
    "budget:update": "UPDATE_REQUEST_BUDGET=1 vitest run test/fake-1c.test.ts",
    "snapshot:metadata": "npm run build && node --env-file=.env dist/scripts/snapshot-metadata.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "ai",
    "llm",
    "1c",
    "1с",
    "1c-enterprise",
    "1с-предприятие",
    "odata",
    "коннектор",
    "connector",
    "integration",
    "интеграция",
    "accounting",
    "бухгалтерия",
    "erp",
    "scloud",
    "1cfresh"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "fast-xml-parser": "^5.11.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
